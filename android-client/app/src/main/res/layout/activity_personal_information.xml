<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/personalinformation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@color/bg_pi">

    <!-- 顶部导航栏 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="0dp"
        android:background="#FFFFFF"
        app:contentInsetStart="0dp">

        <!-- 返回键 -->

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="个人主页"
            android:textColor="#333333"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </androidx.appcompat.widget.Toolbar>
    <!--        添加分割线-->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/bg_pi"/>

    <!-- 用户信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/input_bg"
        android:layout_marginTop="100dp"
        android:layout_marginHorizontal="50dp"
        android:radius="16dp"
        app:cardElevation="4dp">

        <!-- 头像区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_pi_photo"
                 />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户ID"
                android:textColor="#333333"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/infor_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="182****4022"
                android:textColor="#999999"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- 退出登录按钮（新增） -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="退出登录"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_small"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- 功能列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical"
        android:background="@drawable/input_bg"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="60dp"
        android:radius="16dp"
        app:cardElevation="4dp">

        <!-- 关注的股票列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_saved"
                 />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="关注的股票列表"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_weight="1" /> <!-- 关键：占据剩余空间 -->

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ll_ic_arrow_r"
                android:layout_marginEnd="16dp" />


        </LinearLayout>

        <!--        添加分割线-->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bg_pi"/>
        <!-- 最近查看的股票列表（类似结构，替换图标和文字） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_followed"
                 />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="最近查看的股票列表"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ll_ic_arrow_r"
                android:layout_marginEnd="16dp" />

        </LinearLayout>

        <!--        添加分割线-->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bg_pi"/>
        <!-- 制定预警规则（类似结构） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                 />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="制定预警规则"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginStart="16dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ll_ic_arrow_r"
                android:layout_marginEnd="16dp" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>